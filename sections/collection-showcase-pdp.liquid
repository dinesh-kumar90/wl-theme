{{ 'collection-showcase.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Loads the actual @font-face rules for whichever fonts the merchant picks
  in the font_picker settings below. Required by Shopify — font_picker only
  gives you a font's name/CSS values, it doesn't load the font file on its
  own. Scoped to this section's id so multiple instances on the same page
  (rare here, but harmless) don't collide.
{%- endcomment -%}
{%- if section.settings.heading_font -%}
  <style>
    {{ section.settings.heading_font | font_face: font_display: 'swap' }}
  </style>
{%- endif -%}
{%- if section.settings.body_font -%}
  <style>
    {{ section.settings.body_font | font_face: font_display: 'swap' }}
  </style>
{%- endif -%}

{%- comment -%}
  Vendor-matching: find a collection whose title equals this product's
  vendor. Shopify enforces unique collection HANDLES, not unique TITLES,
  so this is a first-match scan — if you ever have two collections
  sharing a title, this takes whichever one appears first in `collections`.
  For large catalogs, consider swapping this for a metafield that stores
  the matched collection's handle directly (O(1) lookup, no scan).
{%- endcomment -%}
{%- assign matched_collection = null -%}
{%- for c in collections -%}
  {%- if c.title == product.vendor -%}
    {%- assign matched_collection = c -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}

{%- if matched_collection != blank -%}
  {%- assign json_id = 'VendorCollectionData-' | append: section.id -%}
  <style>
    #section-{{ json_id }}{
      /* Layout */
        --vcs-max-width: {{ section.settings.max_width }}px;
        --vcs-space-section-y: {{ section.settings.section_padding_block }}px;
        --vcs-space-section-x: {{ section.settings.section_padding_inline }}px;
        --vcs-radius: {{ section.settings.corner_radius }}px;

        /* Colors */
        --vcs-color-bg: {{ section.settings.bg_color | default: '#100e0b' }};
        --vcs-color-text: {{ section.settings.text_color | default: '#efe9df' }};
        --vcs-color-text-muted: {{ section.settings.muted_text_color | default: '#a89f90' }};
        --vcs-color-heading: {{ section.settings.heading_color | default: '#f8f4ea' }};
        --vcs-color-accent: {{ section.settings.accent_color | default: '#d9a13c' }};
        --vcs-color-line: {{ section.settings.line_color | default: 'rgba(255, 255, 255, 0.16)' }};
        --vcs-color-sale: {{ section.settings.sale_color | default: '#c0392b' }};
        --vcs-color-card-bg: {{ section.settings.card_bg_color | default: '#ffffff' }};
        --vcs-color-card-ink: {{ section.settings.card_text_color | default: '#171512' }};
        --vcs-color-card-muted: {{ section.settings.card_muted_color | default: '#8a8378' }};
        --vcs-color-card-line: {{ section.settings.card_border_color | default: '#e7e2d8' }};

        /* Typography */
        {% if section.settings.heading_font -%}
          --vcs-font-heading: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
          --vcs-weight-heading: {{ section.settings.heading_font.weight }};
        {%- endif %}
        {% if section.settings.body_font -%}
          --vcs-font-body: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
        {%- endif %}
        --vcs-size-eyebrow: {{ section.settings.eyebrow_font_size }}px;
        --vcs-size-hero-heading: {{ section.settings.hero_heading_font_size }}px;
        --vcs-size-hero-body: {{ section.settings.hero_body_font_size }}px;
        --vcs-size-grid-heading: {{ section.settings.grid_heading_font_size }}px;
        --vcs-size-card-title: {{ section.settings.card_title_font_size }}px;
        --vcs-size-card-meta: {{ section.settings.card_meta_font_size }}px;
        --vcs-size-price: {{ section.settings.price_font_size }}px;
        --vcs-size-button: {{ section.settings.button_font_size }}px;

        /* Spacing */
        --vcs-space-hero-gap: {{ section.settings.hero_gap }}px;
        --vcs-space-grid-gap: {{ section.settings.grid_gap }}px;
        --vcs-card-padding: {{ section.settings.card_padding }}px;
    }
  </style>
  <section class="vendor-collection-showcase" id="section-{{ json_id }}">
    <script type="application/json" id="{{ json_id }}">
      {
        "vendor": {{ product.vendor | json }},
        "cartAddUrl": {{ routes.cart_add_url | append: '.js' | json }},
        "cartUrl": {{ routes.cart_url | append: '.js' | json }},
        "collection": {
          "title": {{ matched_collection.title | json }},
          "url": {{ matched_collection.url | json }},
          "image": {% if matched_collection.image != blank %}{
            "src": {{ matched_collection.image | image_url: width: 1600 | json }},
            "alt": {{ matched_collection.image.alt | default: matched_collection.title | json }},
            "width": {{ matched_collection.image.width | json }},
            "height": {{ matched_collection.image.height | json }}
          }{% else %}null{% endif %},
          "description": {{ matched_collection.description | default: null | json }},
          "products": [
            {%- for p in matched_collection.products limit: section.settings.product_limit -%}
              {%- unless p.id == product.id -%}
              {%- assign v = p.selected_or_first_available_variant -%}
              {
                "id": {{ p.id | json }},
                "title": {{ p.title | json }},
                "url": {{ p.url | json }},
                "image": {{ p.featured_image | image_url: width: 600 | json }},
                "imageAlt": {{ p.featured_image.alt | default: p.title | json }},
                "variantTitle": {% if v.title == 'Default Title' %}"Default Title"{% else %}{{ v.title | replace: ' / ', ' • ' | json }}{% endif %},
                "price": {{ v.price | json }},
                "compareAtPrice": {{ v.compare_at_price | json }},
                "currency": {{ cart.currency.symbol | json }},
                "rating": {{ p.metafields.reviews.rating.value.rating | default: 4.4 | json }},
                "reviewCount": {{ p.metafields.reviews.rating_count | default: 31 | json }},
                "variantId": {{ v.id | json }},
                "available": {{ v.available | json }}
              }{% unless forloop.last %},{% endunless %}
              {%- endunless -%}
            {%- endfor -%}
          ]
        }
      }
    </script>

    {%- comment -%}
      Every design setting below (Layout / Colors / Typography / Spacing) is
      passed straight through as a --vcs-* CSS custom property. React never
      reads these — they cascade from this element into collection-showcase.css
      via normal inheritance (main.jsx renders into the light DOM, no shadow
      root), so adding a new merchant-editable token later only means adding a
      schema setting here and a var(--vcs-...) in the CSS, nothing in React.
    {%- endcomment -%}
    <collection-showcase
      data-json-id="{{ json_id }}"
      data-cards-mobile="{{ section.settings.cards_mobile }}"
      data-cards-tablet="{{ section.settings.cards_tablet }}"
      data-cards-desktop="{{ section.settings.cards_desktop }}"
      data-view-all-text="{{ section.settings.view_all }}"
    ></collection-showcase>
  </section>
{%- endif -%}
{%- comment -%}
  No matched_collection → nothing renders here at all, per spec.
{%- endcomment -%}

{% schema %}
{
  "name": "Vendor Collection (PDP)",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "range",
